{
  "description": "Fix Claude's output before you see it",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/format.sh" },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/lint-fix.sh" },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/typecheck.sh" },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/test.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/safety-guard.sh" }
        ]
      }
    ]
  }
}
